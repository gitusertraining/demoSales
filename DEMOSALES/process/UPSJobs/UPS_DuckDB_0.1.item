  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="320" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJava_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="// Run the UPS DuckDB SQL script: DuckDB does the heavy lifting (load, cleanse, aggregate, export).&#10;String inputFile = context.ups_input_file.replace(&quot;\\&quot;, &quot;/&quot;).replace(&quot;'&quot;, &quot;''&quot;);&#10;String outputDir = context.output_dir.replace(&quot;\\&quot;, &quot;/&quot;).replace(&quot;'&quot;, &quot;''&quot;);&#10;new java.io.File(context.output_dir).mkdirs();&#10;&#10;String script = new String(java.nio.file.Files.readAllBytes(java.nio.file.Paths.get(context.ups_sql_file)), java.nio.charset.StandardCharsets.UTF_8);&#10;script = script.replace(&quot;${UPS_INPUT_FILE}&quot;, inputFile).replace(&quot;${OUTPUT_DIR}&quot;, outputDir);&#10;&#10;StringBuilder sqlNoComments = new StringBuilder();&#10;for (String line : script.split(&quot;\r?\n&quot;)) {&#10;    if (!line.trim().startsWith(&quot;--&quot;)) {&#10;        sqlNoComments.append(line).append(&quot;\n&quot;);&#10;    }&#10;}&#10;&#10;Class.forName(&quot;org.duckdb.DuckDBDriver&quot;);&#10;java.sql.Connection duckConn = java.sql.DriverManager.getConnection(&quot;jdbc:duckdb:&quot; + context.duckdb_file);&#10;try {&#10;    java.sql.Statement stmt = duckConn.createStatement();&#10;    try {&#10;        for (String sql : sqlNoComments.toString().split(&quot;;\\s*(\\n|$)&quot;)) {&#10;            sql = sql.trim();&#10;            if (sql.isEmpty()) {&#10;                continue;&#10;            }&#10;            System.out.println(&quot;[UPS_DuckDB] &quot; + sql.split(&quot;\n&quot;)[0]);&#10;            stmt.execute(sql);&#10;        }&#10;        java.sql.ResultSet rs = stmt.executeQuery(&quot;SELECT (SELECT count(*) FROM stg_ups_shipments), (SELECT count(*) FROM ups_shipments_clean), (SELECT count(*) FROM ups_rejects)&quot;);&#10;        rs.next();&#10;        globalMap.put(&quot;UPS_RAW_ROWS&quot;, rs.getLong(1));&#10;        globalMap.put(&quot;UPS_CLEAN_ROWS&quot;, rs.getLong(2));&#10;        globalMap.put(&quot;UPS_REJECT_ROWS&quot;, rs.getLong(3));&#10;        rs.close();&#10;    } finally {&#10;        stmt.close();&#10;    }&#10;} finally {&#10;    duckConn.close();&#10;}&#10;globalMap.put(&quot;UPS_SUMMARY_FILE&quot;, outputDir + &quot;/ups_service_summary.csv&quot;);&#10;System.out.println(&quot;[UPS_DuckDB] raw=&quot; + globalMap.get(&quot;UPS_RAW_ROWS&quot;) + &quot; clean=&quot; + globalMap.get(&quot;UPS_CLEAN_ROWS&quot;) + &quot; rejects=&quot; + globalMap.get(&quot;UPS_REJECT_ROWS&quot;));&#10;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="DuckDB load/cleanse/aggregate UPS"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
