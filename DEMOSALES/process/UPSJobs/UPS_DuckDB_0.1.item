  <node componentName="tLibraryLoad" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="96" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tLibraryLoad_1"/>
    <elementParameter field="MODULE_LIST" name="LIBRARY" value="duckdb_jdbc-1.1.3.jar"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="import java.sql.*;"/>
    <elementParameter field="TEXT" name="LABEL" value="Load DuckDB JDBC driver"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <elementParameter field="TABLE" name="HOTLIBS"/>
    <metadata connector="FLOW" name="tLibraryLoad_1"/>
